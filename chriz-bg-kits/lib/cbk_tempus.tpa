// Component 200: Priest of Tempus Overhaul (OHTEMPUS)

DEFINE_ACTION_FUNCTION cbk_install_tempus BEGIN
  LAF cbk_install_res_tempus END
  LAF cbk_get_kit_info STR_VAR kit_name = ~OHTEMPUS~ RET tempus_ids = kit_ids tempus_prof = kit_prof END
  ACTION_IF (tempus_ids < 0) BEGIN
    FAIL ~OHTEMPUS not found in KITLIST.2DA~
  END
  OUTER_SET tempus_data_col = tempus_prof + 1

  // 1. Preserve vanilla/mod casting hooks on OHTMPS2D/E if present when writing CBKTM*D/E
  ACTION_FOR_EACH tier IN ~1~ ~2~ ~3~ BEGIN
    ACTION_FOR_EACH kind IN ~D~ ~E~ BEGIN
      OUTER_SPRINT src_ref ~OHTMPS2%kind%~
      ACTION_IF (FILE_EXISTS_IN_GAME ~%src_ref%.SPL~) BEGIN
        OUTER_SET src_cast_cnt = 0
        OUTER_SET src_proj = (~%kind%~ STR_EQ ~D~) ? 162 : 171
        ACTION_CLEAR_ARRAY cbk_cast_longs
        COPY_EXISTING ~%src_ref%.SPL~ ~override~
          READ_SHORT 0x70 src_cast_cnt
          READ_LONG 0x64 ab_o
          READ_SHORT 0x68 ab_n
          PATCH_IF (ab_n > 0) BEGIN
            READ_SHORT (ab_o + 0x26) src_proj
          END
          PATCH_IF (src_cast_cnt > 0) BEGIN
            READ_LONG 0x6a fx_o
            READ_SHORT 0x6e fx_i
            SET num_longs = src_cast_cnt * 12
            FOR (li = 0; li < num_longs; ++li) BEGIN
              READ_LONG (fx_o + fx_i * 0x30 + li * 4) lv
              SET $cbk_cast_longs(~%li%~) = lv
            END
          END
        BUT_ONLY
        ACTION_IF (src_cast_cnt > 0) BEGIN
          COPY_EXISTING ~CBKTM%tier%%kind%.SPL~ ~override~
            READ_LONG 0x64 cur_ab_o
            READ_SHORT 0x68 cur_ab_n
            READ_LONG 0x6a cur_fx_o
            INSERT_BYTES cur_fx_o (src_cast_cnt * 0x30)
            SET num_longs = src_cast_cnt * 12
            FOR (li = 0; li < num_longs; ++li) BEGIN
              SET lv = $cbk_cast_longs(~%li%~)
              WRITE_LONG (cur_fx_o + li * 4) lv
            END
            WRITE_SHORT 0x70 src_cast_cnt
            FOR (ai = 0; ai < cur_ab_n; ++ai) BEGIN
              SET ao = cur_ab_o + ai * 0x28
              READ_SHORT (ao + 0x20) idx
              WRITE_SHORT (ao + 0x20) (idx + src_cast_cnt)
              WRITE_SHORT (ao + 0x26) src_proj
            END
          BUT_ONLY
        END ELSE BEGIN
          COPY_EXISTING ~CBKTM%tier%%kind%.SPL~ ~override~
            READ_LONG 0x64 cur_ab_o
            READ_SHORT 0x68 cur_ab_n
            FOR (ai = 0; ai < cur_ab_n; ++ai) BEGIN
              WRITE_SHORT (cur_ab_o + ai * 0x28 + 0x26) src_proj
            END
          BUT_ONLY
        END
      END
    END
  END

  // 2. Patch OHTMPS1.SPL with op206 mutual exclusions + descriptions
  ACTION_DEFINE_ARRAY cbk_tx_excl BEGIN ~SPPR412~ ~SPPR507~ ~SPPR513~ ~SPWI603~ END
  OUTER_SET cl_br = IDS_OF_SYMBOL (~spell~ ~CLERIC_BLOOD_RAGE~)
  OUTER_SET cl_ar = IDS_OF_SYMBOL (~spell~ ~CLERIC_ANIMAL_RAGE~)
  ACTION_IF (cl_br > 1000 AND cl_br < 2000) BEGIN
    OUTER_SET br_num = cl_br - 1000
    OUTER_SPRINT $cbk_tx_excl(~4~) ~SPPR%br_num%~
  END
  ACTION_IF (cl_ar > 1000 AND cl_ar < 2000) BEGIN
    OUTER_SET ar_num = cl_ar - 1000
    OUTER_SPRINT $cbk_tx_excl(~5~) ~SPPR%ar_num%~
  END

  COPY_EXISTING ~OHTMPS1.SPL~ ~override~
    SAY NAME1 @201
    SAY UNIDENTIFIED_DESC @202
    PHP_EACH cbk_tx_excl AS _k => excl_res BEGIN
      PATCH_IF (FILE_EXISTS_IN_GAME ~%excl_res%.SPL~) BEGIN
        LPF ADD_SPELL_EFFECT
          INT_VAR opcode = 206 target = 1 parameter1 = 0 - 1 timing = 0 duration = 60 resist_dispel = 2
          STR_VAR resource = EVAL ~%excl_res%~
        END
      END
    END
  BUT_ONLY

  COPY_EXISTING ~OHTMPS2.SPL~ ~override~
    SAY NAME1 @203
    SAY UNIDENTIFIED_DESC @204
  BUT_ONLY

  // 3. Build Divination Toll (CBKTMDV.SPL + CBKTDxxx.EFF for all SPPRxxx with school == 3)
  ACTION_CLEAR_ARRAY cbk_div_spells
  OUTER_SET div_cnt = 0
  OUTER_FOR (num = 100; num < 800; ++num) BEGIN
    OUTER_SPRINT sp ~SPPR%num%~
    ACTION_IF (FILE_EXISTS_IN_GAME ~%sp%.SPL~) BEGIN
      COPY_EXISTING ~%sp%.SPL~ ~override~
        READ_BYTE 0x25 sch
        PATCH_IF (sch = 3) BEGIN
          SPRINT $cbk_div_spells(~%div_cnt%~) ~%sp%~
          SET div_cnt += 1
        END
      BUT_ONLY
    END
  END

  ACTION_PHP_EACH cbk_div_spells AS _i => _res BEGIN
    CREATE EFF ~CBKTD%_i%~
      WRITE_LONG 0x10 172 // Remove Spell
      WRITE_LONG 0x14 1   // Self
      WRITE_LONG 0x24 1   // Instant permanent
      WRITE_SHORT 0x2c 100
      WRITE_ASCIIE 0x30 ~%_res%~ #8
  END

  CREATE SPL ~CBKTMDV~
    INSERT_BYTES 0x72 0x28
    WRITE_SHORT 0x1c 4
    WRITE_LONG 0x64 0x72
    WRITE_SHORT 0x68 1
    WRITE_LONG 0x6a 0x9a
    WRITE_BYTE (0x72 + 0x00) 1
    WRITE_SHORT (0x72 + 0x02) 4
    WRITE_BYTE (0x72 + 0x0c) 5
    WRITE_SHORT (0x72 + 0x10) 1
    WRITE_SHORT (0x72 + 0x24) 1
    WRITE_SHORT (0x72 + 0x26) 1
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 1 timing = 1 STR_VAR resource = ~CBKTMDV~ END
    PHP_EACH cbk_div_spells AS di => dres BEGIN
      LPF ADD_SPELL_EFFECT INT_VAR opcode = 172 target = 1 timing = 1 STR_VAR resource = EVAL ~%dres%~ END
      LPF ADD_SPELL_EFFECT INT_VAR opcode = 272 target = 1 parameter1 = 1 parameter2 = 3 timing = 9 STR_VAR resource = EVAL ~CBKTD%di%~ END
    END

  // 4. Rebuild OHTEMPUS.2DA cleanly (preserving AP_CDHLYSYM at level 25)
  OUTER_SET has_cdhlysym = 0
  ACTION_IF (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) BEGIN
    COPY_EXISTING ~OHTEMPUS.2DA~ ~override~
      PATCH_IF (INDEX_BUFFER (~AP_CDHLYSYM~) >= 0) BEGIN SET has_cdhlysym = 1 END
    BUT_ONLY
  END
  ACTION_IF (FILE_EXISTS_IN_GAME ~CDHLYSYM.SPL~) BEGIN
    OUTER_SET has_cdhlysym = 1
  END

  OUTER_SPRINT clab_hdr ~2DA V1.0%WNL%****%WNL%            ~
  OUTER_FOR (lv = 1; lv <= 50; ++lv) BEGIN
    OUTER_SPRINT clab_hdr ~%clab_hdr%%lv%          ~
  END
  OUTER_SPRINT r1 ~ABILITY1    GA_OHTMPS1  ~
  OUTER_SPRINT r2 ~ABILITY2    GA_OHTMPS2  ~
  OUTER_SPRINT r3 ~ABILITY3    AP_CBKTMP1  ~
  OUTER_SPRINT r4 ~ABILITY4    AP_CBKTMDV  ~
  OUTER_FOR (lv = 2; lv <= 50; ++lv) BEGIN
    ACTION_IF (has_cdhlysym = 1 AND lv = 25) BEGIN
      OUTER_SPRINT r1 ~%r1%AP_CDHLYSYM ~
    END ELSE ACTION_IF ((lv MODULO 5) = 1) BEGIN
      OUTER_SPRINT r1 ~%r1%GA_OHTMPS1  ~
    END ELSE BEGIN
      OUTER_SPRINT r1 ~%r1%****        ~
    END
    ACTION_IF ((lv MODULO 10) = 1) BEGIN
      OUTER_SPRINT r2 ~%r2%GA_OHTMPS2  ~
    END ELSE BEGIN
      OUTER_SPRINT r2 ~%r2%****        ~
    END
    OUTER_SPRINT r3 ~%r3%****        ~
    OUTER_SPRINT r4 ~%r4%****        ~
  END
  COPY ~%MOD_FOLDER%/2da/CBRSPVER.2DA~ ~override/OHTEMPUS.2DA~
    DELETE_BYTES 0 BUFFER_LENGTH
    SPRINT full_clab ~%clab_hdr%%WNL%%r1%%WNL%%r2%%WNL%%r3%%WNL%%r4%%WNL%~
    INSERT_BYTES 0 (STRING_LENGTH ~%full_clab%~)
    WRITE_ASCIIE 0 ~%full_clab%~
    PRETTY_PRINT_2DA

  // 5. WEAPPROF + CBKWPN + CBKAPKIT + CBRKPKIT
  OUTER_SET cbk_tmp_wp_90 = 2
  OUTER_SET cbk_tmp_wp_92 = 2
  OUTER_SET cbk_tmp_wp_103 = 2
  OUTER_SET cbk_tmp_wp_97 = 2
  OUTER_SET cbk_tmp_wp_100 = 2
  OUTER_SET cbk_tmp_wp_101 = 2
  OUTER_SET cbk_tmp_wp_102 = 2
  OUTER_SET cbk_tmp_wp_107 = 2
  OUTER_SET cbk_tmp_wp_115 = 2
  OUTER_SET cbk_tmp_wp_111 = 2
  OUTER_SET cbk_tmp_wp_112 = 2
  OUTER_SET cbk_tmp_wp_113 = 2
  OUTER_SET cbk_tmp_wp_114 = 2
  LAF cbk_set_weapprof_col INT_VAR col_idx = tempus_data_col STR_VAR prof_map_prefix = ~cbk_tmp_wp~ END

  OUTER_PATCH ~~ BEGIN SPRINTF tempus_dec ~%d~ (tempus_ids) END
  ACTION_FOR_EACH pid IN ~90~ ~92~ ~103~ BEGIN
    LAF cbk_append_2da_row_unique
      INT_VAR cols = 6
      STR_VAR
        file = ~CBKWPN.2DA~
        match_key = EVAL ~OHTEMPUS_P%pid%~
        row_line = EVAL ~OHTEMPUS_P%pid% * %tempus_dec% PROF %pid% ALLOW~
    END
  END
  LAF cbk_append_2da_row_unique INT_VAR cols = 4 STR_VAR file = ~CBKAPKIT.2DA~ match_key = ~OHTEMPUS~ row_line = EVAL ~OHTEMPUS %tempus_dec% 2 1~ END
  LAF cbk_append_2da_row_unique INT_VAR cols = 3 STR_VAR file = ~CBRKPKIT.2DA~ match_key = ~OHTEMPUS_FC~ row_line = EVAL ~OHTEMPUS_FC 8 %tempus_dec%~ END
  LAF cbk_append_2da_row_unique INT_VAR cols = 3 STR_VAR file = ~CBRKPKIT.2DA~ match_key = ~OHTEMPUS_CR~ row_line = EVAL ~OHTEMPUS_CR 18 %tempus_dec%~ END

  // 6. KITLIST & CLASTEXT description update (We Overwrite)
  OUTER_SET tx_desc = RESOLVE_STR_REF (@205)
  LAF cbk_update_kit_desc INT_VAR desc_strref = tx_desc STR_VAR kit_name = ~OHTEMPUS~ END

  // 7. BRANWE*.CRE Kit-ID + Battle Axe pip alignment
  OUTER_SET axe_offset_found = 0
  ACTION_FOR_EACH cre IN ~BRANWE~ ~BRANWE5~ ~BRANWE6~ ~BRANWE7~ BEGIN
    ACTION_IF (FILE_EXISTS_IN_GAME ~%cre%.CRE~) BEGIN
      COPY_EXISTING ~%cre%.CRE~ ~override~
        WRITE_SHORT 0x244 ((tempus_ids >> 16) & 0xffff)
        WRITE_SHORT 0x246 (tempus_ids & 0xffff)
        READ_LONG 0x2c4 fx_off
        READ_LONG 0x2c8 fx_cnt
        READ_BYTE 0x33 fx_ver
        SET axe_found = 0
        PATCH_IF (fx_ver = 1) BEGIN
          FOR (fi = 0; fi < fx_cnt; ++fi) BEGIN
            SET o = fx_off + fi * 0x108
            READ_LONG (o + 0x08) op
            READ_LONG (o + 0x18) p2
            PATCH_IF (op = 233 AND p2 = 92) BEGIN
              READ_LONG (o + 0x14) p1
              PATCH_IF (p1 < 1) BEGIN WRITE_LONG (o + 0x14) 1 END
              SET axe_found = 1
            END
          END
          PATCH_IF (axe_found = 0) BEGIN
            SET ins_at = fx_off + fx_cnt * 0x108
            INSERT_BYTES ins_at 0x108
            WRITE_LONG (ins_at + 0x08) 233
            WRITE_LONG (ins_at + 0x0c) 1
            WRITE_LONG (ins_at + 0x14) 1
            WRITE_LONG (ins_at + 0x18) 92
            WRITE_LONG (ins_at + 0x1c) 9
            WRITE_SHORT (ins_at + 0x24) 100
            WRITE_LONG 0x2c8 (fx_cnt + 1)
            FOR (hi = 0x2a0; hi <= 0x2bc; hi += 8) BEGIN
              PATCH_IF (hi = 0x2b8) BEGIN
                READ_LONG 0x2b8 cv
                PATCH_IF (cv >= ins_at) BEGIN WRITE_LONG 0x2b8 (cv + 0x108) END
                READ_LONG 0x2bc cv2
                PATCH_IF (cv2 >= ins_at) BEGIN WRITE_LONG 0x2bc (cv2 + 0x108) END
              END ELSE BEGIN
                READ_LONG hi cv
                PATCH_IF (cv >= ins_at) BEGIN WRITE_LONG hi (cv + 0x108) END
              END
            END
          END
        END ELSE BEGIN
          FOR (fi = 0; fi < fx_cnt; ++fi) BEGIN
            SET o = fx_off + fi * 0x30
            READ_SHORT (o + 0x00) op
            READ_LONG (o + 0x08) p2
            PATCH_IF (op = 233 AND p2 = 92) BEGIN
              READ_LONG (o + 0x04) p1
              PATCH_IF (p1 < 1) BEGIN WRITE_LONG (o + 0x04) 1 END
              SET axe_found = 1
            END
          END
          PATCH_IF (axe_found = 0) BEGIN
            SET ins_at = fx_off + fx_cnt * 0x30
            INSERT_BYTES ins_at 0x30
            WRITE_SHORT (ins_at + 0x00) 233
            WRITE_BYTE (ins_at + 0x02) 1
            WRITE_LONG (ins_at + 0x04) 1
            WRITE_LONG (ins_at + 0x08) 92
            WRITE_BYTE (ins_at + 0x0c) 9
            WRITE_BYTE (ins_at + 0x12) 100
            WRITE_LONG 0x2c8 (fx_cnt + 1)
            FOR (hi = 0x2a0; hi <= 0x2bc; hi += 8) BEGIN
              PATCH_IF (hi = 0x2b8) BEGIN
                READ_LONG 0x2b8 cv
                PATCH_IF (cv >= ins_at) BEGIN WRITE_LONG 0x2b8 (cv + 0x30) END
                READ_LONG 0x2bc cv2
                PATCH_IF (cv2 >= ins_at) BEGIN WRITE_LONG 0x2bc (cv2 + 0x30) END
              END ELSE BEGIN
                READ_LONG hi cv
                PATCH_IF (cv >= ins_at) BEGIN WRITE_LONG hi (cv + 0x30) END
              END
            END
          END
        END
      BUT_ONLY
    END
  END
END
