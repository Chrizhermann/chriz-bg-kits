    WRITE_LONG 0x262 cbk_splprot_CBK_STATE_TRANSFORMATION_EQ
    WRITE_LONG 0x292 cbk_state_TRANSFORMATION
    WRITE_LONG 0x2c2 cbk_state_CBM_STR_FLOOR
    WRITE_LONG 0x382 cbk_splprot_CBK_STATE_TRANSFORMATION_EQ
    WRITE_LONG 0x3b2 cbk_state_TRANSFORMATION
    WRITE_LONG 0x3e2 cbk_state_CBM_STR_FLOOR
    WRITE_LONG 0x4a2 cbk_splprot_CBK_STATE_TRANSFORMATION_EQ
    WRITE_LONG 0x4d2 cbk_state_TRANSFORMATION
    WRITE_LONG 0x502 cbk_state_CBM_STR_FLOOR
    WRITE_LONG 0x5c2 cbk_splprot_CBK_STATE_TRANSFORMATION_EQ
    WRITE_LONG 0x5f2 cbk_state_TRANSFORMATION
    WRITE_LONG 0x622 cbk_state_CBM_STR_FLOOR
  COPY ~%MOD_FOLDER%/res/OHTMPS2.SPL~ ~override/OHTMPS2.SPL~
  COPY ~%MOD_FOLDER%/res/CBKTM1D.SPL~ ~override/CBKTM1D.SPL~
  COPY ~%MOD_FOLDER%/res/CBKTM2D.SPL~ ~override/CBKTM2D.SPL~
  COPY ~%MOD_FOLDER%/res/CBKTM3D.SPL~ ~override/CBKTM3D.SPL~
  COPY ~%MOD_FOLDER%/res/CBKTM1E.SPL~ ~override/CBKTM1E.SPL~
  COPY ~%MOD_FOLDER%/res/CBKTM2E.SPL~ ~override/CBKTM2E.SPL~
  COPY ~%MOD_FOLDER%/res/CBKTM3E.SPL~ ~override/CBKTM3E.SPL~
END

