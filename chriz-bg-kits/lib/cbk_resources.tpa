  COPY ~%MOD_FOLDER%/res/CBKSWND.SPL~ ~override/CBKSWND.SPL~
    SAY 0x15e @90001
END

DEFINE_ACTION_FUNCTION cbk_install_res_stonefire BEGIN
  LAF cbk_ensure_resource_symbols RET cbk_state_CBK_BR_WINDED cbk_state_CBK_ELM_AIR cbk_state_CBK_ELM_EARTH cbk_state_CBK_ELM_FIRE cbk_state_CBK_ELM_HLA cbk_state_CBK_ELM_RESOLVED cbk_state_CBK_ELM_WATER cbk_state_CBK_RAC_RESOLVED cbk_state_CBK_RAGE_EXTENDED cbk_state_CBK_STONEFIRE_ARMOR cbk_state_CBK_STR_CLAMP_1 cbk_state_CBM_STR_FLOOR cbk_state_TRANSFORMATION cbk_splprot_CBK_PROF_BATTLEAXE_GE_1 cbk_splprot_CBK_RESISTMAGIC_GE_50 cbk_splprot_CBK_STATE_104_EQ cbk_splprot_CBK_STATE_104_NEQ cbk_splprot_CBK_STATE_BR_WINDED_EQ cbk_splprot_CBK_STATE_ELM_HLA_EQ cbk_splprot_CBK_STATE_RAGE_EXT_EQ cbk_splprot_CBK_STATE_SF_ARMOR_EQ cbk_splprot_CBK_STATE_TRANSFORMATION_EQ cbk_splprot_CBK_STR_GE_2 END
  COPY ~%MOD_FOLDER%/res/CBKARCDS.EFF~ ~override/CBKARCDS.EFF~
  COPY ~%MOD_FOLDER%/res/CBKSF00.SPL~ ~override/CBKSF00.SPL~
    WRITE_LONG 0xa2 cbk_state_CBK_STONEFIRE_ARMOR
  COPY ~%MOD_FOLDER%/res/CBKSFR1.SPL~ ~override/CBKSFR1.SPL~
  COPY ~%MOD_FOLDER%/res/CBKSFR2.SPL~ ~override/CBKSFR2.SPL~
  COPY ~%MOD_FOLDER%/res/CBKSFCN.SPL~ ~override/CBKSFCN.SPL~
  COPY ~%MOD_FOLDER%/res/CBKSFC1.SPL~ ~override/CBKSFC1.SPL~
  COPY ~%MOD_FOLDER%/res/CBKSFC2.SPL~ ~override/CBKSFC2.SPL~
  COPY ~%MOD_FOLDER%/res/CBKSFC3.SPL~ ~override/CBKSFC3.SPL~
  COPY ~%MOD_FOLDER%/res/CBKSFC4.SPL~ ~override/CBKSFC4.SPL~
  COPY ~%MOD_FOLDER%/res/CBKSFC5.SPL~ ~override/CBKSFC5.SPL~
  COPY ~%MOD_FOLDER%/res/CBKSFC6.SPL~ ~override/CBKSFC6.SPL~
  COPY ~%MOD_FOLDER%/res/CBKSFC7.SPL~ ~override/CBKSFC7.SPL~
  COPY ~%MOD_FOLDER%/res/CBKSFC8.SPL~ ~override/CBKSFC8.SPL~
  COPY ~%MOD_FOLDER%/res/CBKSFC9.SPL~ ~override/CBKSFC9.SPL~
  COPY ~%MOD_FOLDER%/res/CBKSF01.SPL~ ~override/CBKSF01.SPL~
    SET _cbk_pj = IDS_OF_SYMBOL (~projectl~ ~INAREANP~)
    PATCH_IF (_cbk_pj >= 0) BEGIN WRITE_SHORT 0x98 (_cbk_pj + 1) END
    SET _cbk_pj = IDS_OF_SYMBOL (~projectl~ ~INAREANP~)
    PATCH_IF (_cbk_pj >= 0) BEGIN WRITE_SHORT 0xc0 (_cbk_pj + 1) END
    SET _cbk_pj = IDS_OF_SYMBOL (~projectl~ ~INAREANP~)
    PATCH_IF (_cbk_pj >= 0) BEGIN WRITE_SHORT 0xe8 (_cbk_pj + 1) END
END

DEFINE_ACTION_FUNCTION cbk_install_res_tempus BEGIN
  LAF cbk_ensure_resource_symbols RET cbk_state_CBK_BR_WINDED cbk_state_CBK_ELM_AIR cbk_state_CBK_ELM_EARTH cbk_state_CBK_ELM_FIRE cbk_state_CBK_ELM_HLA cbk_state_CBK_ELM_RESOLVED cbk_state_CBK_ELM_WATER cbk_state_CBK_RAC_RESOLVED cbk_state_CBK_RAGE_EXTENDED cbk_state_CBK_STONEFIRE_ARMOR cbk_state_CBK_STR_CLAMP_1 cbk_state_CBM_STR_FLOOR cbk_state_TRANSFORMATION cbk_splprot_CBK_PROF_BATTLEAXE_GE_1 cbk_splprot_CBK_RESISTMAGIC_GE_50 cbk_splprot_CBK_STATE_104_EQ cbk_splprot_CBK_STATE_104_NEQ cbk_splprot_CBK_STATE_BR_WINDED_EQ cbk_splprot_CBK_STATE_ELM_HLA_EQ cbk_splprot_CBK_STATE_RAGE_EXT_EQ cbk_splprot_CBK_STATE_SF_ARMOR_EQ cbk_splprot_CBK_STATE_TRANSFORMATION_EQ cbk_splprot_CBK_STR_GE_2 END
  COPY ~%MOD_FOLDER%/res/CBKTMP1.SPL~ ~override/CBKTMP1.SPL~
